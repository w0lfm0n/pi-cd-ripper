# Copy to /etc/cd-ripper.env and edit. Sourced by the systemd services and the
# rip/vinyl scripts. Keep the real file OFF GitHub (it holds your Plex token).
#
#   sudo cp config.env.example /etc/cd-ripper.env
#   sudo nano /etc/cd-ripper.env

# Where ripped albums are written — your Plex music library, mounted on the Pi.
# Also set the SAME path as OUTPUTDIR in config/abcde.conf.
MUSIC_DIR=/mnt/music/Music

# --- Plex (optional) --------------------------------------------------------
# Used to trigger a library scan after each rip so albums + art appear quickly.
# Leave PLEX_URL blank to disable. Find a token: https://support.plex.tv/articles/204059436
PLEX_URL=
PLEX_TOKEN=
# Your Music library's section id. Find it at:
#   http://PLEX_HOST:32400/library/sections?X-Plex-Token=YOUR_TOKEN
PLEX_SECTION=1

# --- Notifications (optional) ----------------------------------------------
# A webhook fired on "already owned", rip complete, and vinyl saved. It receives
# a POST with JSON {"event": "...", "context": "..."}. Leave blank to disable.
# (Point it at ntfy, Gotify, Home Assistant, a Discord relay, whatever you like.)
NOTIFY_URL=
